{
  "name": "claude-code-daodan",
  "displayName": "Claude Code Daodan",
  "description": "87 agents, 68 skills and 49 prompts for GitHub Copilot: code review, documentation, testing, research, frontend, trading, observability and more.",
  "version": "19.1.2",
  "publisher": "acaprino",
  "license": "MIT",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "copilot",
    "agents",
    "skills",
    "prompts",
    "code-review",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/acaprino/claude-code-daodan.git"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vscode:uninstall": "node ./uninstall.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "daodan.syncSkills",
        "title": "Install or Refresh Skills",
        "category": "Daodan"
      },
      {
        "command": "daodan.removeSkills",
        "title": "Remove Installed Skills",
        "category": "Daodan"
      },
      {
        "command": "daodan.openSkillsFolder",
        "title": "Reveal Skills Folder",
        "category": "Daodan"
      }
    ],
    "configuration": {
      "title": "Claude Code Daodan",
      "properties": {
        "daodan.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Install and refresh the bundled skills automatically when the extension starts or is updated."
        },
        "daodan.skillsLocation": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where to install the bundled skills. Empty means `~/.copilot/skills`, which VS Code reads in every workspace. Set another path only if you keep personal skills elsewhere, and make sure it is one VS Code scans."
        }
      }
    },
