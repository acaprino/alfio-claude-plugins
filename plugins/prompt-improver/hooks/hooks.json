{
  "hooks": {
    "UserPromptSubmit": [
      {
        "description": "Improves user prompts by adding clarifying questions",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/handlers/improve-prompt.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "description": "Injects plan readability guidance when entering plan mode",
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/handlers/plan-guidance.js\"",
            "timeout": 15
          }
        ]
      },
      {
        "description": "Encourages background execution for long-running Bash commands (dev servers, watchers, tail)",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/handlers/background-exec.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "description": "Token-efficiency guidance for Explore/Plan research subagents",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/handlers/subagent-routing.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
